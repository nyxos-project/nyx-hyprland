prepare() {
	ln -sf hyprland-source "$_archive"
	cd "$_archive"
	patch -Np1 -i "$srcdir/0001-gestures-add-workspace_swipe_wrap.patch"
	patch -Np1 -i "$srcdir/0002-output-add-virtual-region-partitioning.patch"
	patch -Np1 -i "$srcdir/0003-output-add-virtual-monitors.patch"
	patch -Np1 -i "$srcdir/0004-render-composite-virtual-regions-on-their-host.patch"
	patch -Np1 -i "$srcdir/0005-workspaces-per-region-workspace-selector-and-pointer.patch"
	patch -Np1 -i "$srcdir/0006-virtual-monitors-add-merge-restore-physical-fullscre.patch"
	patch -Np1 -i "$srcdir/0007-ipc-expose-virtual-monitors.patch"
	patch -Np1 -i "$srcdir/0008-hyprtester-add-virtual-monitor-tests.patch"
	sed -i -e '/^release:/{n;s/-D/-DCMAKE_SKIP_RPATH=ON -D/}' Makefile
	sed -i -e '/find_package.glaze/s/7...<8 //' {.,hyprpm,start}/CMakeLists.txt
}

build() {
	cd "$_archive"
	make release PREFIX=/usr
}

