From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ken Smith <ken@design-nex.us>
Date: Wed, 11 Nov 2026 18:46:50 -0600
Subject: [PATCH] layers: top layers slide with the workspace when it meets a
 fullscreen one

While a workspace with a true fullscreen window and one without are both
on screen (a workspace swipe, or a workspace slide still animating), the
top layers that fullscreen hides (bars, docks) are drawn at the offset of
the workspace without one, at full opacity. A bar leaves with its
workspace when swiping to a fullscreen app and comes back with it,
instead of covering the app until the swipe ends and then fading out.

A swipe no longer shows those layers when it starts from a fullscreen
workspace, and its end sets their opacity at once rather than fading it,
as they are already where they belong.
---
 .../input/UnifiedWorkspaceSwipeGesture.cpp    | 13 ++-----
 src/render/Renderer.cpp                       | 37 +++++++++++++++++--
 2 files changed, 37 insertions(+), 13 deletions(-)

diff --git a/src/managers/input/UnifiedWorkspaceSwipeGesture.cpp b/src/managers/input/UnifiedWorkspaceSwipeGesture.cpp
index f4c456583..06ddf7a59 100644
--- a/src/managers/input/UnifiedWorkspaceSwipeGesture.cpp
+++ b/src/managers/input/UnifiedWorkspaceSwipeGesture.cpp
@@ -141,8 +141,10 @@ void CUnifiedWorkspaceSwipeGesture::restoreLayers() {
     const bool HIDE      = MODE == Fullscreen::FSMODE_FULLSCREEN &&
         (!FSWINDOW || !Fullscreen::controller()->layoutManagedFS(FSWINDOW) || (SPACE && SPACE->algorithm() && Fullscreen::controller()->hasFullscreen(WORKSPACE, true)));
 
+    // During the swipe, top layers hidden by fullscreen moved with the workspace without a
+    // fullscreen window (see renderLayer), so a fade now would show them over the app.
     for (const auto& ls : MONITOR->m_layerSurfaceLayers[2]) {
-        *ls->alpha()[Desktop::View::LS_ALPHA_FADE] = HIDE ? 0.F : 1.F;
+        ls->alpha()[Desktop::View::LS_ALPHA_FADE]->setValueAndWarp(HIDE ? 0.F : 1.F);
     }
 }
 
@@ -202,15 +204,6 @@ bool CUnifiedWorkspaceSwipeGesture::begin(PHLMONITOR monitor) {
     m_listeners.monitorDestroy          = MONITOR->m_events.destroy.listen([this] { cancel(); });
     m_listeners.workspaceMonitorChanged = PWORKSPACE->m_events.monitorChanged.listen(VALIDATE);
     m_listeners.workspaceActiveChanged  = PWORKSPACE->m_events.activeChanged.listen(VALIDATE);
-
-    const auto FSWINDOW         = Fullscreen::controller()->getFullscreenWindow(PWORKSPACE);
-    const auto INTERNAL_FS_MODE = FSWINDOW ? Fullscreen::controller()->getFullscreenModes(FSWINDOW).internal : Fullscreen::FSMODE_NONE;
-
-    if (INTERNAL_FS_MODE == Fullscreen::FSMODE_FULLSCREEN) {
-        for (auto const& ls : MONITOR->m_layerSurfaceLayers[2]) {
-            *ls->alpha()[Desktop::View::LS_ALPHA_FADE] = 1.F;
-        }
-    }
     return true;
 }
 
diff --git a/src/render/Renderer.cpp b/src/render/Renderer.cpp
index b7a6247b9..1affbf65c 100644
--- a/src/render/Renderer.cpp
+++ b/src/render/Renderer.cpp
@@ -1013,6 +1013,30 @@ SP<ITexture> IHyprRenderer::createTexture(const SP<Aquamarine::IBuffer> buffer,
     return tex;
 }
 
+static std::optional<Vector2D> topLayerSlideOffset(PHLMONITOR pMonitor) {
+    PHLWORKSPACE normal;
+    bool         fullscreen = false;
+
+    for (auto const& ref : State::Workspace::state()->workspaces()) {
+        const auto ws = ref.lock();
+        if (!ws || ws->type() == Workspace::eWorkspaceType::SPECIAL || ws->m_monitor != pMonitor || ws->m_alpha->value() <= 0.F)
+            continue;
+
+        if (ws != pMonitor->m_activeWorkspace && !ws->m_forceRendering && !ws->m_renderOffset->isBeingAnimated())
+            continue;
+
+        if (Fullscreen::controller()->getFullscreenModes(ws, true).internal == Fullscreen::FSMODE_FULLSCREEN)
+            fullscreen = true;
+        else if (!normal)
+            normal = ws;
+    }
+
+    if (!fullscreen || !normal)
+        return std::nullopt;
+
+    return normal->m_renderOffset->value();
+}
+
 void IHyprRenderer::renderLayer(CRenderContext& ctx, PHLLS pLayer, PHLMONITOR pMonitor, const Time::steady_tp& time, bool popups, bool lockscreen, bool workspaceScene) {
     if (!pLayer)
         return;
@@ -1020,7 +1044,14 @@ void IHyprRenderer::renderLayer(CRenderContext& ctx, PHLLS pLayer, PHLMONITOR pM
     if (!ctx.shouldRenderContent(pLayer->m_ruleApplicator->noScreenShare().valueOrDefault()))
         return;
 
-    if (!pLayer->mapped() || (!workspaceScene && !pLayer->acceptsInput()) || !pLayer->alphaNonZero())
+    // While a workspace with a true fullscreen window slides next to one without, the top
+    // layers that fullscreen hides move with the one without, at full opacity.
+    std::optional<Vector2D> slideOffset;
+    if (pLayer->m_layer == ZWLR_LAYER_SHELL_V1_LAYER_TOP && !(pLayer->m_flags & Desktop::View::LAYER_FLAG_ABOVE_FULLSCREEN) && !workspaceScene && !lockscreen &&
+        !ctx.m_renderingSnapshot)
+        slideOffset = topLayerSlideOffset(pMonitor);
+
+    if (!pLayer->mapped() || (!workspaceScene && !pLayer->acceptsInput()) || (!slideOffset && !pLayer->alphaNonZero()))
         return;
 
     // skip rendering based on abovelock rule and make sure to not render abovelock layers twice
@@ -1039,11 +1070,11 @@ void IHyprRenderer::renderLayer(CRenderContext& ctx, PHLLS pLayer, PHLMONITOR pM
 
     TRACY_GPU_ZONE("RenderLayer");
 
-    const auto                       REALPOS = pLayer->position(Desktop::View::IGeometric::GEOMETRIC_CURRENT);
+    const auto                       REALPOS = pLayer->position(Desktop::View::IGeometric::GEOMETRIC_CURRENT) + slideOffset.value_or(Vector2D{});
     const auto                       REALSIZ = pLayer->size(Desktop::View::IGeometric::GEOMETRIC_CURRENT);
 
     CSurfacePassElement::SRenderData renderdata = {pMonitor, time, REALPOS};
-    renderdata.fadeAlpha                        = pLayer->alpha()[LS_ALPHA_FADE]->value();
+    renderdata.fadeAlpha                        = slideOffset ? 1.F : pLayer->alpha()[LS_ALPHA_FADE]->value();
     renderdata.blur                             = !ctx.m_renderingSnapshot && pLayer->shouldBlur();
     renderdata.surface                          = pLayer->wlSurface()->resource();
     renderdata.decorate                         = false;
