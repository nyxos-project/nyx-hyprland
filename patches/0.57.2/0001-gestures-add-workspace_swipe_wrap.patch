From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ken Smith <ken@design-nex.us>
Date: Wed, 4 Nov 2026 09:29:45 -0600
Subject: [PATCH] gestures: add workspace_swipe_wrap

Swiping past the last workspace on a monitor wraps around to the first,
and back from the first lands on the last, following the same m+1/m-1
neighbours that workspace dispatchers already wrap around.
---
 hyprtester/src/tests/main/gestures.cpp        | 36 +++++++++++++++++++
 src/config/values/ConfigValues.cpp            |  1 +
 .../input/UnifiedWorkspaceSwipeGesture.cpp    | 12 ++++---
 3 files changed, 44 insertions(+), 5 deletions(-)

diff --git a/hyprtester/src/tests/main/gestures.cpp b/hyprtester/src/tests/main/gestures.cpp
index 3f4b3e083..693922f83 100644
--- a/hyprtester/src/tests/main/gestures.cpp
+++ b/hyprtester/src/tests/main/gestures.cpp
@@ -389,3 +389,39 @@ TEST_CASE(gestures) {
         OK(getFromSocket(std::format("/dispatch hl.dsp.cursor.move({{ x = {}, y = {} }})", x.value(), y.value())));
     }
 }
+
+TEST_CASE(workspaceSwipeWrap) {
+    OK(getFromSocket("/eval hl.monitor({ output = 'HEADLESS-WRAP', mode = '1920x1080@60', position = 'auto-right', scale = '1' })"));
+    OK(getFromSocket("/output create headless HEADLESS-WRAP"));
+    ASSERT_CONTAINS(getFromSocket("/monitors"), "HEADLESS-WRAP");
+    OK(getFromSocket("/dispatch hl.dsp.focus({ monitor = 'HEADLESS-WRAP' })"));
+    for (const auto& ws : {"11", "12", "13"}) {
+        OK(getFromSocket(std::format("/eval hl.workspace_rule({{ workspace = '{}', monitor = 'HEADLESS-WRAP', persistent = true }})", ws)));
+    }
+    OK(getFromSocket("/dispatch hl.dsp.focus({ workspace = '13' })"));
+    EXPECT_COUNT_STRING(getFromSocket("/workspaces"), "on monitor HEADLESS-WRAP", 3);
+
+    OK(getFromSocket("/eval hl.config({ gestures = { workspace_swipe_invert = 0, workspace_swipe_create_new = 0 } })"));
+    OK(getFromSocket("/eval hl.plugin.test.alt(1)"));
+
+    // Without wrap, the swipe stops at the last workspace.
+    OK(getFromSocket("/eval hl.plugin.test.gesture('right', 3)"));
+    EXPECT_CONTAINS(getFromSocket("/activeworkspace"), "ID 13 (13)");
+
+    OK(getFromSocket("/eval hl.config({ gestures = { workspace_swipe_wrap = 1 } })"));
+
+    OK(getFromSocket("/eval hl.plugin.test.gesture('right', 3)"));
+    EXPECT_CONTAINS(getFromSocket("/activeworkspace"), "ID 11 (11)");
+
+    OK(getFromSocket("/eval hl.plugin.test.gesture('left', 3)"));
+    EXPECT_CONTAINS(getFromSocket("/activeworkspace"), "ID 13 (13)");
+
+    // Wrapping wins over creating a new workspace past the last one.
+    OK(getFromSocket("/eval hl.config({ gestures = { workspace_swipe_create_new = 1 } })"));
+    OK(getFromSocket("/eval hl.plugin.test.gesture('right', 3)"));
+    EXPECT_CONTAINS(getFromSocket("/activeworkspace"), "ID 11 (11)");
+
+    OK(getFromSocket("/eval hl.plugin.test.alt(0)"));
+    OK(getFromSocket("/output remove HEADLESS-WRAP"));
+    OK(getFromSocket("/reload"));
+}
diff --git a/src/config/values/ConfigValues.cpp b/src/config/values/ConfigValues.cpp
index deabc8ad3..60aaa4bc1 100644
--- a/src/config/values/ConfigValues.cpp
+++ b/src/config/values/ConfigValues.cpp
@@ -495,6 +495,7 @@ std::vector<SP<IValue>> Values::getConfigValues() {
         MS<Int>("gestures:workspace_swipe_direction_lock_threshold", "in px, the distance to swipe before direction lock activates.", 10, {.min = 0, .max = 200}),
         MS<Bool>("gestures:workspace_swipe_forever", "if enabled, swiping will not clamp at the neighboring workspaces but continue to the further ones.", false),
         MS<Bool>("gestures:workspace_swipe_use_r", "if enabled, swiping will use the r prefix instead of the m prefix for finding workspaces.", false),
+        MS<Bool>("gestures:workspace_swipe_wrap", "if enabled, swiping past the last workspace on a monitor wraps around to the first, and vice versa.", false),
         MS<Int>("gestures:close_max_timeout", "Timeout for closing windows with the close gesture, in ms.", 1000, {.min = 10, .max = 2000}),
         MS<Bool>("gestures:scrolling:move_snap_to_grid", "When releasing the scroll move gesture, whether it shoud try to snap to the grid.", true),
         MS<Bool>("gestures:scrolling:move_snap_cursor", "When releasing the scroll move gesture, whether it shoud snap the cursor to the newly focused window.", true),
diff --git a/src/managers/input/UnifiedWorkspaceSwipeGesture.cpp b/src/managers/input/UnifiedWorkspaceSwipeGesture.cpp
index b1960c88d..2204bd12c 100644
--- a/src/managers/input/UnifiedWorkspaceSwipeGesture.cpp
