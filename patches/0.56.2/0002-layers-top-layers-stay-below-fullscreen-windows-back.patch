From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ken Smith <ken@design-nex.us>
Date: Tue, 10 Nov 2026 13:34:49 -0600
Subject: [PATCH] layers: top layers stay below fullscreen windows (backport of
 815e3a822)

setNoMembersAboveFullscreen() set every layer on the monitor to the
fullscreen state of the space that called it, so a fullscreen change on
another workspace of the monitor (a maximize ending, say) put bars back
above a fullscreen window: they took its pointer input. As in 0.57,
fullscreen changes now only clear the flag, and a layer mapped or moved
to the top layer while a window is fullscreen stays under it unless
misc:allow_new_top_layers_over_existing_fullscreen allows it.
---
 src/config/values/ConfigValues.cpp            |  1 +
 src/desktop/view/LayerSurface.cpp             | 25 +++++++++++++------
 .../scrolling/ScrollingFullscreenHandler.cpp  |  2 +-
 .../fullscreen/handler/FullscreenHandler.cpp  |  4 ++-
 4 files changed, 22 insertions(+), 10 deletions(-)

diff --git a/src/config/values/ConfigValues.cpp b/src/config/values/ConfigValues.cpp
index 4a08b7b19..427caefbe 100644
--- a/src/config/values/ConfigValues.cpp
+++ b/src/config/values/ConfigValues.cpp
@@ -488,6 +488,7 @@ std::vector<SP<IValue>> Values::getConfigValues() {
         MS<Bool>("misc:name_vk_after_proc", "Name virtual keyboards after the processes that create them.", true),
         MS<Bool>("misc:always_follow_on_dnd", "Will make mouse focus follow the mouse when drag and dropping.", true),
         MS<Bool>("misc:layers_hog_keyboard_focus", "If true, will make keyboard-interactive layers keep their focus on mouse move.", true),
+        MS<Bool>("misc:allow_new_top_layers_over_existing_fullscreen", "If true, allows new top layers to go over a fullscreen window.", true),
         MS<Bool>("misc:animate_manual_resizes", "If true, will animate manual window resizes/moves", false),
         MS<Bool>("misc:animate_mouse_windowdragging", "If true, will animate windows being dragged by mouse.", false),
         MS<Bool>("misc:disable_autoreload", "If true, the config will not reload automatically on save.", false, {.refresh = Supplementary::REFRESH_CONFIG_WATCHER}),
diff --git a/src/desktop/view/LayerSurface.cpp b/src/desktop/view/LayerSurface.cpp
index 2143d5a8c..e6c3252e6 100644
--- a/src/desktop/view/LayerSurface.cpp
+++ b/src/desktop/view/LayerSurface.cpp
@@ -16,6 +16,7 @@
 #include "../../managers/fullscreen/FullscreenController.hpp"
 #include "../../event/EventBus.hpp"
 #include "../../state/MonitorState.hpp"
+#include "../../config/ConfigValue.hpp"
 
 using namespace Desktop;
 using namespace Desktop::View;
@@ -162,9 +163,8 @@ void CLayerSurface::onDestroy() {
 void CLayerSurface::onMap() {
     Log::logger->log(Log::DEBUG, "LayerSurface {:x} mapped", rc<uintptr_t>(m_layerSurface.get()));
 
-    m_mapped          = true;
-    m_interactivity   = m_layerSurface->m_current.interactivity;
-    m_aboveFullscreen = true;
+    m_mapped        = true;
+    m_interactivity = m_layerSurface->m_current.interactivity;
 
     m_ruleApplicator->propertiesChanged(Desktop::Rule::RULE_PROP_ALL);
 
@@ -176,6 +176,11 @@ void CLayerSurface::onMap() {
     if (!PMONITOR)
         return;
 
+    static auto PALLOWNEWTOPOVERFULLSCREEN = CConfigValue<Config::INTEGER>("misc:allow_new_top_layers_over_existing_fullscreen");
+
+    // Fullscreen only clears this flag, so a bar mapped over a fullscreen window stays under it unless allowed.
+    m_aboveFullscreen = m_layer >= ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY || (m_layer == ZWLR_LAYER_SHELL_V1_LAYER_TOP && *PALLOWNEWTOPOVERFULLSCREEN);
+
     PMONITOR->m_scheduledRecalc = true;
 
     g_pHyprRenderer->arrangeLayersForMonitor(PMONITOR->m_id);
@@ -213,7 +218,9 @@ void CLayerSurface::onMap() {
     m_realPosition->setConfig(Config::animationTree()->getAnimationPropertyConfig("layersIn"));
     m_realSize->setConfig(Config::animationTree()->getAnimationPropertyConfig("layersIn"));
     m_alpha.get(LS_ALPHA_FADE)->setConfig(Config::animationTree()->getAnimationPropertyConfig("fadeLayersIn"));
-    m_animationController.apply(m_animationController.animateIn());
+
+    if (!Fullscreen::controller()->hasFullscreen(PMONITOR, true) || m_aboveFullscreen)
+        m_animationController.apply(m_animationController.animateIn());
 
     g_pEventManager->postEvent(SHyprIPCEvent{.event = "openlayer", .data = m_namespace});
     Event::bus()->m_events.layer.opened.emit(m_self.lock());
@@ -324,11 +331,13 @@ void CLayerSurface::onCommit() {
                 }
             }
 
-            m_layer           = NEW_LAYER;
-            m_aboveFullscreen = NEW_LAYER >= ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY;
+            m_layer = NEW_LAYER;
 
-            // if in fullscreen, only overlay can be above.
-            *m_alpha.get(LS_ALPHA_FADE) = Fullscreen::controller()->hasFullscreen(PMONITOR) ? (m_layer >= ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY ? 1.F : 0.F) : 1.F;
+            static auto PALLOWNEWTOPOVERFULLSCREEN = CConfigValue<Config::INTEGER>("misc:allow_new_top_layers_over_existing_fullscreen");
+            m_aboveFullscreen = m_layer >= ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY || (m_layer == ZWLR_LAYER_SHELL_V1_LAYER_TOP && *PALLOWNEWTOPOVERFULLSCREEN);
+
+            // if in fullscreen, only layers allowed above it show.
+            *m_alpha.get(LS_ALPHA_FADE) = Fullscreen::controller()->hasFullscreen(PMONITOR, true) ? (m_aboveFullscreen ? 1.F : 0.F) : 1.F;
 
             if (m_layer == ZWLR_LAYER_SHELL_V1_LAYER_BACKGROUND || m_layer == ZWLR_LAYER_SHELL_V1_LAYER_BOTTOM)
                 PMONITOR->m_blurFBDirty = true; // so that blur is recalc'd
diff --git a/src/layout/algorithm/tiled/scrolling/ScrollingFullscreenHandler.cpp b/src/layout/algorithm/tiled/scrolling/ScrollingFullscreenHandler.cpp
index 17f6f5207..95e810369 100644
--- a/src/layout/algorithm/tiled/scrolling/ScrollingFullscreenHandler.cpp
+++ b/src/layout/algorithm/tiled/scrolling/ScrollingFullscreenHandler.cpp
@@ -333,7 +333,7 @@ void CScrollingFullscreenHandler::setNoMembersAboveFullscreen() {
         }
         for (auto const& ls : Desktop::layerState()->layers()) {
             if (ls->m_monitor == MONITOR)
-                ls->m_aboveFullscreen = !SET;
+                ls->m_aboveFullscreen = false;
         }
     };
 
diff --git a/src/managers/fullscreen/handler/FullscreenHandler.cpp b/src/managers/fullscreen/handler/FullscreenHandler.cpp
index fef3881a7..2b130048b 100644
--- a/src/managers/fullscreen/handler/FullscreenHandler.cpp
+++ b/src/managers/fullscreen/handler/FullscreenHandler.cpp
@@ -271,9 +271,11 @@ void IFullscreenHandler::setNoMembersAboveFullscreen() {
             w->updateFullscreenInputState();
         }
     }
+    // Only a map or a layer change (see CLayerSurface) may put a top layer above fullscreen again;
+    // a fullscreen change on another workspace of this monitor must not.
     for (auto const& ls : Desktop::layerState()->layers()) {
         if (ls->m_monitor == MONITOR)
-            ls->m_aboveFullscreen = !SET;
+            ls->m_aboveFullscreen = false;
     }
 }
 
