 src/output/VirtualRegions.hpp    |  29 +++++++++
 tests/helpers/VirtualRegions.cpp | 106 +++++++++++++++++++++++++++++++
 3 files changed, 219 insertions(+)
 create mode 100644 src/output/VirtualRegions.cpp
 create mode 100644 src/output/VirtualRegions.hpp
 create mode 100644 tests/helpers/VirtualRegions.cpp

diff --git a/src/output/VirtualRegions.cpp b/src/output/VirtualRegions.cpp
new file mode 100644
index 000000000..42e75e796
--- /dev/null
+++ b/src/output/VirtualRegions.cpp
@@ -0,0 +1,84 @@
+#include "VirtualRegions.hpp"
+
+#include <hyprutils/memory/Casts.hpp>
+
+#include <cmath>
+#include <format>
+
+using namespace Monitor::Virtual;
+using namespace Hyprutils::Memory;
+
+int64_t Monitor::Virtual::logicalPixelStep(double scale) {
+    if (!std::isfinite(scale) || scale <= 0)
+        return 1;
+
+    for (int64_t step = 1; step <= 120; ++step) {
+        const double LOGICAL = sc<double>(step) / scale;
+        if (std::abs(LOGICAL - std::round(LOGICAL)) < 1e-6)
+            return step;
+    }
+
+    return 1;
+}
+
+std::expected<std::vector<SRegionSpan>, std::string> Monitor::Virtual::partition(int64_t pixelWidth, double scale, std::span<const double> ratios, double minLogicalWidth) {
+    if (ratios.empty() || ratios.size() > MAX_REGIONS)
+        return std::unexpected(std::format("need 1 to {} regions, got {}", MAX_REGIONS, ratios.size()));
+
+    if (pixelWidth <= 0)
+        return std::unexpected("the output has no width");
+
+    if (!std::isfinite(scale) || scale <= 0)
+        return std::unexpected("invalid scale");
+
+    double total = 0;
+    for (const auto r : ratios) {
+        if (!std::isfinite(r) || r <= 0)
+            return std::unexpected("region proportions must be positive");
+        total += r;
+    }
+
+    const int64_t            STEP = logicalPixelStep(scale);
+    std::vector<SRegionSpan> spans;
+    spans.reserve(ratios.size());
+
+    double  cumulative = 0;
+    int64_t start      = 0;
+    for (size_t i = 0; i < ratios.size(); ++i) {
+        cumulative += ratios[i];
+
+        int64_t end = pixelWidth;
+        if (i + 1 < ratios.size())
+            end = std::llround(cumulative / total * sc<double>(pixelWidth) / sc<double>(STEP)) * STEP;
+
+        if (end <= start || end > pixelWidth)
+            return std::unexpected(std::format("region {} would be empty", i + 1));
+
+        spans.push_back({.x = start, .width = end - start});
+        start = end;
+    }
+
+    for (size_t i = 0; i < spans.size(); ++i) {
+        const double LOGICAL = sc<double>(spans[i].width) / scale;
+        if (LOGICAL + 1e-6 < minLogicalWidth)
+            return std::unexpected(std::format("region {} would be {:.0f} logical pixels wide, less than the minimum of {:.0f}", i + 1, LOGICAL, minLogicalWidth));
+    }
+
+    return spans;
+}
+
+std::expected<std::vector<double>, std::string> Monitor::Virtual::presetRatios(std::string_view preset, size_t count) {
+    if (count == 0 || count > MAX_REGIONS)
+        return std::unexpected(std::format("need 1 to {} regions, got {}", MAX_REGIONS, count));
+
+    if (preset == "equal" || preset.empty())
+        return std::vector<double>(count, 1.0);
+
+    if (preset == "center" || preset == "center-focused") {
+        if (count != 3)
+            return std::unexpected("the center-focused preset needs 3 regions");
+        return std::vector<double>{1.0, 2.0, 1.0};
+    }
+
+    return std::unexpected(std::format("unknown preset \"{}\"", preset));
+}
diff --git a/src/output/VirtualRegions.hpp b/src/output/VirtualRegions.hpp
new file mode 100644
index 000000000..802cfc72d
--- /dev/null
+++ b/src/output/VirtualRegions.hpp
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <cstdint>
+#include <expected>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace Monitor::Virtual {
+    constexpr size_t MAX_REGIONS = 3;
+
+    // A horizontal slice of a host output, in host pixels.
+    struct SRegionSpan {
+        int64_t x     = 0;
+        int64_t width = 0;
+    };
+
+    // The smallest pixel count that is a whole number of logical pixels at this scale,
+    // e.g. 5 at 1.25, 3 at 1.5, 2 at 2. 1 if there is none up to 120.
+    int64_t logicalPixelStep(double scale);
+
+    // Splits pixelWidth into ratios.size() adjacent spans that cover it exactly, with
+    // every boundary on a logicalPixelStep() multiple. The last span takes the rest.
+    std::expected<std::vector<SRegionSpan>, std::string> partition(int64_t pixelWidth, double scale, std::span<const double> ratios, double minLogicalWidth);
+
+    // Ratios for a named preset: "equal" (any count) or "center" (3 regions, 25/50/25).
+    std::expected<std::vector<double>, std::string> presetRatios(std::string_view preset, size_t count);
+}
diff --git a/tests/helpers/VirtualRegions.cpp b/tests/helpers/VirtualRegions.cpp
new file mode 100644
index 000000000..8e3bd3c07
--- /dev/null
+++ b/tests/helpers/VirtualRegions.cpp
@@ -0,0 +1,106 @@
+#include <output/VirtualRegions.hpp>
+
+#include <gtest/gtest.h>
+
+using namespace Monitor::Virtual;
+
+static void expectCovers(const std::vector<SRegionSpan>& spans, int64_t width) {
+    ASSERT_FALSE(spans.empty());
+    EXPECT_EQ(spans.front().x, 0);
+    for (size_t i = 1; i < spans.size(); ++i) {
+        EXPECT_EQ(spans[i].x, spans[i - 1].x + spans[i - 1].width);
+    }
+    EXPECT_EQ(spans.back().x + spans.back().width, width);
+}
+
+TEST(VirtualRegions, logicalPixelStep) {
+    EXPECT_EQ(logicalPixelStep(1.0), 1);
+    EXPECT_EQ(logicalPixelStep(1.25), 5);
+    EXPECT_EQ(logicalPixelStep(1.5), 3);
+    EXPECT_EQ(logicalPixelStep(1.6), 8);
+    EXPECT_EQ(logicalPixelStep(2.0), 2);
+    EXPECT_EQ(logicalPixelStep(4.0 / 3.0), 4);
+    EXPECT_EQ(logicalPixelStep(0.0), 1);
+    EXPECT_EQ(logicalPixelStep(-1.0), 1);
+}
+
+TEST(VirtualRegions, equalThirdsOfDualUhd) {
+    const std::vector<double> ratios = {1, 1, 1};
+    const auto                spans  = partition(7680, 1.0, ratios, 640);
+    ASSERT_TRUE(spans.has_value()) << spans.error();
+    ASSERT_EQ(spans->size(), 3);
+    expectCovers(*spans, 7680);
+    EXPECT_EQ((*spans)[0].width, 2560);
+    EXPECT_EQ((*spans)[1].width, 2560);
+    EXPECT_EQ((*spans)[2].width, 2560);
+}
+
+TEST(VirtualRegions, equalThirdsWithRemainder) {
+    const std::vector<double> ratios = {1, 1, 1};
+    const auto                spans  = partition(3440, 1.0, ratios, 640);
+    ASSERT_TRUE(spans.has_value()) << spans.error();
+    expectCovers(*spans, 3440);
+    EXPECT_EQ((*spans)[0].width, 1147);
+    EXPECT_EQ((*spans)[1].width, 1146);
+    EXPECT_EQ((*spans)[2].width, 1147);
+}
+
+TEST(VirtualRegions, centerFocusedAtFractionalScale) {
+    const auto ratios = presetRatios("center-focused", 3);
+    ASSERT_TRUE(ratios.has_value());
+    const auto spans = partition(7680, 1.25, *ratios, 640);
+    ASSERT_TRUE(spans.has_value()) << spans.error();
+    expectCovers(*spans, 7680);
+    EXPECT_EQ((*spans)[0].width, 1920);
+    EXPECT_EQ((*spans)[1].width, 3840);
+    EXPECT_EQ((*spans)[2].width, 1920);
+    for (const auto& s : *spans) {
+        EXPECT_EQ(s.x % 5, 0);
+        EXPECT_EQ(s.width % 5, 0);
+    }
+}
+
+TEST(VirtualRegions, customRatiosSnapToScaleStep) {
+    const std::vector<double> ratios = {20, 55, 25};
+    const auto                spans  = partition(7680, 1.5, ratios, 640);
+    ASSERT_TRUE(spans.has_value()) << spans.error();
+    expectCovers(*spans, 7680);
+    for (const auto& s : *spans) {
+        EXPECT_EQ(s.x % 3, 0);
+    }
+    EXPECT_NEAR(static_cast<double>((*spans)[0].width) / 7680.0, 0.20, 0.001);
+    EXPECT_NEAR(static_cast<double>((*spans)[1].width) / 7680.0, 0.55, 0.001);
+}
+
+TEST(VirtualRegions, singleRegionIsWholeOutput) {
+    const std::vector<double> ratios = {1};
+    const auto                spans  = partition(5120, 2.0, ratios, 640);
+    ASSERT_TRUE(spans.has_value());
+    ASSERT_EQ(spans->size(), 1);
+    EXPECT_EQ((*spans)[0].x, 0);
+    EXPECT_EQ((*spans)[0].width, 5120);
+}
+
+TEST(VirtualRegions, rejectsBadInput) {
+    const std::vector<double> none;
+    const std::vector<double> four     = {1, 1, 1, 1};
+    const std::vector<double> negative = {1, -1};
+    const std::vector<double> tiny     = {1, 20};
+    const std::vector<double> two      = {1, 1};
+
+    EXPECT_FALSE(partition(3840, 1.0, none, 640).has_value());
+    EXPECT_FALSE(partition(3840, 1.0, four, 640).has_value());
+    EXPECT_FALSE(partition(3840, 1.0, negative, 640).has_value());
+    EXPECT_FALSE(partition(3840, 1.0, tiny, 640).has_value());
+    EXPECT_FALSE(partition(0, 1.0, two, 640).has_value());
+    EXPECT_FALSE(partition(3840, 0.0, two, 640).has_value());
+    EXPECT_FALSE(partition(1000, 1.0, two, 640).has_value());
+}
+
+TEST(VirtualRegions, presets) {
+    EXPECT_EQ(presetRatios("equal", 2)->size(), 2);
+    EXPECT_FALSE(presetRatios("center", 2).has_value());
+    EXPECT_FALSE(presetRatios("nope", 2).has_value());
+    EXPECT_FALSE(presetRatios("equal", 0).has_value());
+    EXPECT_FALSE(presetRatios("equal", 4).has_value());
+}
