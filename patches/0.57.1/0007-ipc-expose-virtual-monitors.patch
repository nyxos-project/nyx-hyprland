From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ken Smith <ken@design-nex.us>
Date: Mon, 9 Nov 2026 23:11:18 -0600
Subject: [PATCH] ipc: expose virtual monitors

hyprctl monitors gains a virtual field (region or host details), hyprctl
virtualmonitors lists groups and configs, socket2 posts virtualmonitor and
virtualmonitorv2 events, Lua monitors get is_virtual, virtual_host,
virtual_index and virtual_regions, and hyprctl output remove refuses regions.
---
 src/config/lua/objects/LuaMonitor.cpp | 23 ++++++++-
 src/ipc/s1/Commands.cpp               | 68 ++++++++++++++++++++++++++-
 2 files changed, 89 insertions(+), 2 deletions(-)

diff --git a/src/config/lua/objects/LuaMonitor.cpp b/src/config/lua/objects/LuaMonitor.cpp
index 8c67cb192..df6fd75f9 100644
--- a/src/config/lua/objects/LuaMonitor.cpp
+++ b/src/config/lua/objects/LuaMonitor.cpp
@@ -163,7 +163,28 @@ static int monitorIndex(lua_State* L) {
         lua_pushboolean(L, mon->m_vrrActive);
     else if (key == "is_mirror")
         lua_pushboolean(L, mon->isMirror());
-    else if (key == "mirrors") {
+    else if (key == "is_virtual")
+        lua_pushboolean(L, mon->isVirtualRegion());
+    else if (key == "virtual_host") {
+        if (const auto HOST = mon->m_virtual.host.lock())
+            Objects::CLuaMonitor::push(L, HOST);
+        else
+            lua_pushnil(L);
+    } else if (key == "virtual_index")
+        lua_pushinteger(L, sc<lua_Integer>(mon->m_virtual.index));
+    else if (key == "virtual_regions") {
+        lua_newtable(L);
+
+        int i = 1;
+        for (const auto& regionRef : mon->m_virtual.regions) {
+            const auto REGION = regionRef.lock();
+            if (!REGION)
+                continue;
+
+            Objects::CLuaMonitor::push(L, REGION);
+            lua_rawseti(L, -2, i++);
+        }
+    } else if (key == "mirrors") {
         lua_newtable(L);
 
         int i = 1;
diff --git a/src/ipc/s1/Commands.cpp b/src/ipc/s1/Commands.cpp
index fb12ee225..4dde79ac2 100644
