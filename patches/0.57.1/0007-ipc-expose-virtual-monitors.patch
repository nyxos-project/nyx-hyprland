+static std::string virtualMonitorsRequest(eHyprCtlOutputFormat format, std::string request) {
+    return format == eHyprCtlOutputFormat::FORMAT_JSON ? Monitor::virtualMonitors()->toJSON() : Monitor::virtualMonitors()->toText();
+}
